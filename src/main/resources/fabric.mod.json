{
  "schemaVersion": 1,
  "id": "skyblocker-addons",
  "version": "${version}",
  "name": "Skyblocker Addons",
  "description": "Small additions and fixes for Skyblocker: case-insensitive command shortcuts and slayer session stats in the Slayer HUD.",
  "authors": ["Strayer"],
  "contact": {
    "sources": "https://github.com/Strayercat/Skyblocker-Addons"
  },
  "license": "MIT",
  "icon": "assets/skyblocker-addons/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.skyblockeraddons.client.SkyblockerAddonsClient"]
  },
  "mixins": [
    {
      "config": "skyblocker-addons.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "skyblocker": "*"
  }
}
